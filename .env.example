# Copy to .env (never commit it). Every variable is optional.
LSE_PROVIDER=ollama                 # ollama | anthropic | fake
LSE_MODEL=qwen3:4b                  # claude-sonnet-5-5 for anthropic
LSE_JUDGE_PROVIDER=                 # default: same as LSE_PROVIDER
LSE_JUDGE_MODEL=                    # default: qwen3:4b (ollama) / claude-haiku-4-5-20251001
OLLAMA_HOST=http://127.0.0.1:11434  # loopback only unless the next line is 1
LSE_ALLOW_REMOTE_OLLAMA=
LSE_TEMPERATURE=0
LSE_MAX_STEPS=8
LSE_PRICE_IN=0                      # USD per 1M input tokens (0 for a local model)
LSE_PRICE_OUT=0                     # USD per 1M output tokens
# Optional adapters and the optional upload path. This project never sets or uses them itself.
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
